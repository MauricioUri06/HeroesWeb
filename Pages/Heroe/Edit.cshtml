@page
@model Heroes.Pages_Heroe.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Heroe</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Heroe.Id" />
            <div class="form-group">
                <label asp-for="Heroe.Nombre" class="control-label"></label>
                <input asp-for="Heroe.Nombre" class="form-control" />
                <span asp-validation-for="Heroe.Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Heroe.Ciudad" class="control-label"></label>
                <input asp-for="Heroe.Ciudad" class="form-control" />
                <span asp-validation-for="Heroe.Ciudad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Heroe.IdentidadSecreta" class="control-label"></label>
                <input asp-for="Heroe.IdentidadSecreta" class="form-control" />
                <span asp-validation-for="Heroe.IdentidadSecreta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
